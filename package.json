{
  "name": "@thomasremblier/design-system",
  "version": "0.1.2",
  "description": "Design system de Thomas Remblier, artiste CGI produit : tokens, CSS, composants et assets.",
  "license": "MIT",
  "author": "Thomas Remblier <contact@thomasremblier.fr> (https://thomasremblier.fr)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thomasrembl/design-system.git"
  },
  "type": "module",
  "files": [
    "css",
    "tokens",
    "assets"
  ],
  "exports": {
