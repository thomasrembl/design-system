{
  "$description": "Tokens de la marque Thomas Remblier. Format W3C Design Tokens ; le nom de chaque token est son nom CSS sans « -- ». Modifier ici puis lancer npm run build.",
  "couleur": {
    "theme": {
      "$description": "Couleurs · thème sombre « studio »",
      "bg": { "$type": "color", "$value": "#0f0f0f", "$description": "Noir studio : fond" },
      "surface": { "$type": "color", "$value": "#161616", "$description": "Vignettes, panneaux, tableaux" },
      "surface-2": { "$type": "color", "$value": "#1e1e1e", "$description": "Champs, boutons discrets, état actif" },
      "surface-3": { "$type": "color", "$value": "#262626", "$description": "Survols" },
      "field-hover": { "$type": "color", "$value": "#232323", "$description": "Champ survolé" },
      "ink": { "$type": "color", "$value": "#edebe7", "$description": "Encre : texte, titres" },
      "muted": { "$type": "color", "$value": "#8f8c87", "$description": "Gris : texte secondaire, labels" },
      "accent": { "$type": "color", "$value": "#f3f3f2", "$description": "Blanc cassé : une seule action principale par écran" },
      "accent-hover": { "$type": "color", "$value": "#ffffff", "$description": "Action principale survolée" },
      "on-accent": { "$type": "color", "$value": "#0f0f0f", "$description": "Texte sur l'action principale" },
      "focus": { "$type": "color", "$value": "#f3f3f2", "$description": "Contour de focus (2 px)" },
      "line": { "$type": "color", "$value": "rgb(255 255 255 / 0.08)", "$description": "Filets (outil : tableaux, KPI)" },
      "line-soft": { "$type": "color", "$value": "rgb(255 255 255 / 0.05)", "$description": "Filets discrets" },
      "field-border": { "$type": "color", "$value": "#76736e", "$description": "Contour de champ (≥ 3 : 1 sur les surfaces)" },
      "panel": { "$type": "color", "$value": "rgb(22 22 22 / 0.84)", "$description": "Surface à peine transparente : le studio s'atténue derrière" },
      "scrim": { "$type": "color", "$value": "rgb(0 0 0 / 0.55)", "$description": "Voile derrière un panneau ou un tiroir" },
      "overlay-strong": { "$type": "color", "$value": "rgb(8 8 8 / 0.96)", "$description": "Voile plein écran : visionneuse, bande démo" },
      "overlay-soft": { "$type": "color", "$value": "rgb(8 8 8 / 0.45)", "$description": "Voile léger sur un aperçu vidéo" },
      "chip": { "$type": "color", "$value": "rgb(15 15 15 / 0.72)", "$description": "Pastille translucide sur un média : étiquette, loupe, note" },
      "bar": { "$type": "color", "$value": "rgb(15 15 15 / 0.92)", "$description": "Barre du haut translucide (mobile)" },
      "video-bg": { "$type": "color", "$value": "#000000", "$description": "Fond d'un lecteur vidéo (bandes noires)" },
      "highlight": { "$type": "color", "$value": "#3a2f1c", "$description": "Surlignage « à compléter » (ambre très sombre)" }
    },
    "lumiere": {
      "$description": "Couleurs · lumière studio : uniquement en lumière (halos, reflets, rendus, graphiques), jamais en aplat sur un composant",
      "key": { "$type": "color", "$value": "#ffe2be", "$extensions": { "fr.thomasremblier": { "format": "rgb-triplet" } }, "$description": "Lumière principale, chaude — triplet RVB : rgb(var(--key) / 0.13)" },
      "rim": { "$type": "color", "$value": "#c4d6ff", "$extensions": { "fr.thomasremblier": { "format": "rgb-triplet" } }, "$description": "Lumière de contour, froide — triplet RVB" },
      "chart-chaud": { "$type": "color", "$value": "#ffe2be", "$description": "Série principale des graphiques" },
      "chart-froid": { "$type": "color", "$value": "#9fb6e6", "$description": "Série secondaire des graphiques" },
      "chart-neutre": { "$type": "color", "$value": "#8f8c87", "$description": "Série neutre des graphiques" }
    },
    "etat": {
      "$description": "Couleurs · états (outil uniquement, toujours accompagnés d'un mot)",
      "amber": { "$type": "color", "$value": "#d9a441", "$description": "À surveiller, en attente" },
      "red": { "$type": "color", "$value": "#e26d5c", "$description": "En retard ; contour d'un champ en erreur et filet de la notice d'erreur" },
      "error": { "$type": "color", "$value": "#ec9a90", "$description": "Texte d'erreur (message, titre de notice)" },
      "ok": { "$type": "color", "$value": "#8fb996", "$description": "Fait, encaissé" }
    },
    "papier": {
      "$description": "Couleurs · papier (devis, factures, documents imprimés)",
      "paper": { "$type": "color", "$value": "#f3f3f2", "$description": "Fond papier" },
      "paper-surface": { "$type": "color", "$value": "#ebe9e5", "$description": "Encadrés sur papier" },
      "paper-ink": { "$type": "color", "$value": "#0f0f0f", "$description": "Texte sur papier" },
      "paper-muted": { "$type": "color", "$value": "#6b6964", "$description": "Mentions sur papier (4,9 : 1)" },
      "paper-line": { "$type": "color", "$value": "rgb(15 15 15 / 0.12)", "$description": "Filets sur papier" }
    }
  },
  "typo": {
    "$description": "Typographie · Geist, trois graisses",
    "font": { "$type": "fontFamily", "$value": ["Geist Variable", "system-ui", "sans-serif"] },
    "w-light": { "$type": "fontWeight", "$value": 300, "$description": "Titres, accroches, chiffres clés" },
    "w-text": { "$type": "fontWeight", "$value": 350, "$description": "Texte courant, interface" },
    "w-strong": { "$type": "fontWeight", "$value": 450, "$description": "Boutons, titres de vignettes" },
    "step-small": { "$type": "dimension", "$value": "clamp(0.8125rem, 0.79rem + 0.1vw, 0.875rem)", "$description": "Petit : 13 → 14 px" },
    "step-ui": { "$type": "dimension", "$value": "1rem", "$description": "Interface : 16 px" },
    "step-body": { "$type": "dimension", "$value": "clamp(1.0625rem, 1rem + 0.25vw, 1.1875rem)", "$description": "Corps : 17 → 19 px" },
    "step-lead": { "$type": "dimension", "$value": "clamp(1.25rem, 1.1rem + 0.7vw, 1.625rem)", "$description": "Accroche : 20 → 26 px" },
    "step-kpi": { "$type": "dimension", "$value": "clamp(1.25rem, 1.05rem + 0.55vw, 1.625rem)", "$description": "Chiffre clé : 20 → 26 px" },
    "step-title": { "$type": "dimension", "$value": "clamp(1.75rem, 1.4rem + 1.4vw, 2.5rem)", "$description": "Titre : 28 → 40 px" },
    "step-head": { "$type": "dimension", "$value": "clamp(2rem, 1.3rem + 3.2vw, 4rem)", "$description": "Display : 32 → 64 px" }
  },
  "espace": {
    "$description": "Espacements · base 4",
    "space-4": { "$type": "dimension", "$value": "4px" },
    "space-8": { "$type": "dimension", "$value": "8px" },
    "space-12": { "$type": "dimension", "$value": "12px" },
    "space-16": { "$type": "dimension", "$value": "16px" },
    "space-24": { "$type": "dimension", "$value": "24px" },
    "space-32": { "$type": "dimension", "$value": "32px" },
    "space-48": { "$type": "dimension", "$value": "48px" },
    "space-64": { "$type": "dimension", "$value": "64px" },
    "space-80": { "$type": "dimension", "$value": "80px" },
    "space-120": { "$type": "dimension", "$value": "120px" },
    "gutter": { "$type": "dimension", "$value": "clamp(16px, 2.2vw, 32px)", "$description": "Marge latérale fluide" },
    "gap": { "$type": "dimension", "$value": "10px", "$description": "Écart entre colonnes de la grille vitrine" }
  },
  "forme": {
    "$description": "Rayons et ombre",
    "radius": { "$type": "dimension", "$value": "6px", "$description": "Rayon unique" },
    "radius-pill": { "$type": "dimension", "$value": "999px", "$description": "Badges" },
    "shadow-panel": { "$type": "shadow", "$value": "-30px 0 80px rgb(0 0 0 / 0.5)", "$description": "Seule ombre : panneaux flottants" }
  },
  "taille": {
    "$description": "Largeurs et hauteurs",
    "sidebar": { "$type": "dimension", "$value": "304px", "$description": "Sidebar vitrine (272 px en contexte outil)" },
    "sidebar-tool": { "$type": "dimension", "$value": "272px", "$description": "Sidebar outil" },
    "column": { "$type": "dimension", "$value": "560px", "$description": "Colonne de texte (≈ 65 signes)" },
    "legal": { "$type": "dimension", "$value": "680px", "$description": "Pages légales" },
    "page": { "$type": "dimension", "$value": "1240px", "$description": "Page outil" },
    "panel-width": { "$type": "dimension", "$value": "540px", "$description": "Panneau latéral" },
    "modal-width": { "$type": "dimension", "$value": "480px", "$description": "Modale de confirmation" },
    "bar-height": { "$type": "dimension", "$value": "68px", "$description": "Barre du haut du téléphone, sans l'encoche" },
    "button-height": { "$type": "dimension", "$value": "44px", "$description": "Bouton (cible tactile minimale)" },
    "button-height-sm": { "$type": "dimension", "$value": "36px", "$description": "Petit bouton" },
    "field-height": { "$type": "dimension", "$value": "48px", "$description": "Champ" }
  },
  "mouvement": {
    "$description": "Mouvement · une seule courbe, coupée par prefers-reduced-motion",
    "ease": { "$type": "cubicBezier", "$value": [0.22, 1, 0.36, 1], "$description": "Départ franc, arrivée très douce" },
    "dur-color": { "$type": "duration", "$value": "200ms", "$description": "Couleurs, survols" },
    "dur-button": { "$type": "duration", "$value": "250ms", "$description": "Boutons, navigation" },
    "dur-menu": { "$type": "duration", "$value": "350ms", "$description": "Menu" },
    "dur-panel": { "$type": "duration", "$value": "500ms", "$description": "Panneaux et tiroirs (450 → 550 ms)" },
    "dur-reveal": { "$type": "duration", "$value": "900ms", "$description": "Apparitions : fondu + 22 px" },
    "dur-zoom": { "$type": "duration", "$value": "1200ms", "$description": "Zoom de vignette (× 1,035)" }
  }
}
